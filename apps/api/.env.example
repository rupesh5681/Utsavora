# Copy to .env and adjust. Never commit real credentials.
DATABASE_URL=postgresql://utsavora:utsavora@localhost:5432/utsavora
PORT=4000
NODE_ENV=development
# Comma-separated origins of the three web apps (only needed if calling the API cross-origin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Set to true behind HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Seed: initial admin account (change immediately after first login in production).
SEED_ADMIN_EMAIL=admin@utsavora.local
SEED_ADMIN_PASSWORD=ChangeMe-2026
# Seed demo vendors/listings (clearly labelled as demo). Disable in production.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Utsav-Demo-2026
