# Copy to .env and adjust. Never commit real credentials.
# SQL Server connection string (ADO.NET format). SQL Server authentication must be enabled (Mixed Mode).
# Named instance example: Server=localhost\\SQLEXPRESS;Database=utsavora;...
DATABASE_URL=Server=localhost,1433;Database=utsavora;User Id=utsavora_app;Password=ChangeMe-Db-2026!;Encrypt=true;TrustServerCertificate=true
# Connections in the API's pool.
DB_POOL_MAX=10
PORT=4000
NODE_ENV=development
# Comma-separated origins of the three web apps (only needed if calling the API cross-origin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Set to true behind HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Seed: initial admin account (change immediately after first login in production).
SEED_ADMIN_EMAIL=admin@utsavora.local
SEED_ADMIN_PASSWORD=ChangeMe-2026
# Seed demo vendors/listings (clearly labelled as demo). Disable in production.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Utsav-Demo-2026
